# =========================================================
# FICHIER EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# Renommez ce fichier en '.env' et remplissez vos valeurs.
# =========================================================


# =========================================================
# 🔵 CONFIGURATION DATABASE (MySQL)
# =========================================================

# Mot de passe root MySQL (utilisé par Docker + Spring Boot)
MYSQL_ROOT_PASSWORD=my_secure_root_password

# Nom de la base de données utilisée par l'application
MYSQL_DATABASE=ecoplateform

# URL JDBC utilisée par Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://mysqldb:3306/ecoplateform

# Identifiants Spring Boot pour MySQL
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}


# =========================================================
# 🔵 CONFIGURATION MAIL (SMTP)
# =========================================================

# Adresse email utilisée pour envoyer les emails
SPRING_MAIL_USERNAME=your_address_mail

# Mot de passe d'application Gmail 
SPRING_MAIL_PASSWORD=your_application_password


# =========================================================
# 🌍 ENVIRONNEMENT APPLICATION
# =========================================================

# Nom de l'application Spring Boot
SPRING_APPLICATION_NAME=path_to_project/eco-gamification-platform

